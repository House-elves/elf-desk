[Unit]
Description=Elf Desk (the morning board)
Wants=network-online.target
After=network-online.target elf-desk-pg.service
Requires=elf-desk-pg.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/elf-desk
EnvironmentFile=%h/.config/elf-desk/env
ExecStart=%h/.sdkman/candidates/java/current/bin/java -Xmx512m -jar %h/.local/share/elf-desk/app/quarkus-run.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=default.target
